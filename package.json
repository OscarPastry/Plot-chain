{
  "name": "plot-chain",
  "version": "0.1.0",
  "private": true,
  "description": "Blockchain-based land registry with centimeter-level precision geospatial mapping",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "cargo run --manifest-path apps/server/Cargo.toml",
    "dev:chain": "npm run node --workspace=packages/contracts",
    "build:web": "npm run build --workspace=apps/web",
    "build:server": "cargo build --manifest-path apps/server/Cargo.toml",
    "compile:contracts": "npm run compile --workspace=packages/contracts",
    "test:server": "cargo test --manifest-path apps/server/Cargo.toml",
    "test:contracts": "npm run test --workspace=packages/contracts",
    "deploy:contracts": "npm run deploy --workspace=packages/contracts",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
